{
  "name": "Weather Information Tool",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "city"
            },
            {
              "name": "country_code"
            },
            {
              "name": "units"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "d2e4ce6d-f600-4daf-bea9-ce0fbcf47891",
      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "city-not-empty",
              "leftValue": "={{ $json.city }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              },
              "rightValue": ""
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          }
        },
        "options": {}
      },
      "id": "e71d33e9-cd8a-4f79-a2ad-310c0c827e2d",
      "name": "Validate Input",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "format": "={{ $json.units === 'imperial' ? 'imperial' : 'metric' }}",
        "cityName": "={{ $json.country_code ? `${$json.city.trim()},${$json.country_code.trim()}` : $json.city.trim() }}"
      },
      "type": "n8n-nodes-base.openWeatherMap",
      "typeVersion": 1,
      "position": [
        448,
        -96
      ],
      "id": "17255a99-5a8d-4137-996e-374e14dc0dda",
      "name": "OpenWeatherMap",
      "onError": "continueRegularOutput",
      "credentials": {
        "openWeatherMapApi": {
          "id": "saatTOUOgfGt6kA5",
          "name": "OpenWeatherMap account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "err-success",
              "name": "success",
              "type": "boolean",
              "value": false
            },
            {
              "id": "err-msg",
              "name": "error",
              "type": "string",
              "value": "City name is required and cannot be empty."
            }
          ]
        },
        "options": {}
      },
      "id": "30b519a3-a88b-4267-a478-2408a6c5e543",
      "name": "Missing City Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        448,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst triggerData = $('When Executed by Another Workflow').first().json;\nconst units = triggerData.units === 'imperial' ? 'imperial' : 'metric';\n\nif (item.error || item.message || !item.main) {\n  return [{\n    json: {\n      success: false,\n      error: item.message || item.error || 'Failed to retrieve weather data for the specified location.'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    success: true,\n    city: item.name,\n    country: item.sys?.country || null,\n    temperature: item.main.temp,\n    feels_like: item.main.feels_like,\n    humidity: item.main.humidity,\n    condition: item.weather?.[0]?.description || item.weather?.[0]?.main || 'Unknown',\n    wind_speed: item.wind?.speed ?? 0,\n    units: units\n  }\n}];"
      },
      "id": "3d53783a-2f14-41bb-93f3-2c626281f073",
      "name": "Normalize Weather Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        -96
      ]
    }
  ],
  "connections": {
    "When Executed by Another Workflow": {
      "main": [
        [
          {
            "node": "Validate Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Input": {
      "main": [
        [
          {
            "node": "OpenWeatherMap",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Missing City Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenWeatherMap": {
      "main": [
        [
          {
            "node": "Normalize Weather Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate",
    "availableInMCP": true
  }
}
